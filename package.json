{
  "name": "@assforge/cogent-sandbox",
  "version": "0.1.2",
  "type": "module",
  "description": "Sandboxed multi-agent workbench: isolated persistent AI-agent workspaces over Docker containers and host tmux",
  "bin": {
    "sandbox": "./dist/bin/sandbox.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/assforge/agent-sandbox.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/bin/sandbox.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
